<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Credit Assistant</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&family=Newsreader:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#14213A;--paper:#EDF1F6;--card:#fff;--line:#D9E0EA;--muted:#5C6B82;--acc:#0F7C86;--hero:#10213C;--track:#DCE3EE;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--ink:#E8EEF7;--paper:#0B1424;--card:#13203A;--line:#243452;--muted:#98A8C3;--acc:#2DB6C2;--hero:#0A1830;--track:#26385A}}
:root[data-theme="dark"]{--ink:#E8EEF7;--paper:#0B1424;--card:#13203A;--line:#243452;--muted:#98A8C3;--acc:#2DB6C2;--hero:#0A1830;--track:#26385A}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 Manrope,system-ui,sans-serif}
h1,h2,h3{font-family:Newsreader,Georgia,serif;line-height:1.2;margin:0 0 .5em}
h2{font-size:1.3rem}
.wrap{max-width:1020px;margin:0 auto;padding:0 16px 56px}
header{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:16px 0}
.brand{font:700 1.35rem Newsreader,serif;margin-right:auto}
nav{display:flex;gap:4px;flex-wrap:wrap}
nav button,.ghost{background:none;border:1px solid transparent;border-radius:8px;padding:8px 12px;font:600 .95rem Manrope,sans-serif;color:var(--muted);cursor:pointer}
nav button.on{background:var(--card);color:var(--ink);border-color:var(--line)}
.ghost{border-color:var(--line);color:var(--ink)}
main{display:flex;flex-direction:column;gap:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px}
.hero{background:var(--hero);color:#EAF1FB;border-color:transparent;display:grid;grid-template-columns:minmax(0,340px) 1fr;gap:24px;align-items:center}
.hero svg{width:100%;height:auto}
.big{font:700 3.6rem/1 Newsreader,serif}
.badge{display:inline-block;padding:3px 12px;border-radius:99px;color:#fff;font-weight:800;font-size:.9rem;margin-left:10px;vertical-align:middle}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}
.stats div{background:rgba(255,255,255,.08);border-radius:10px;padding:10px 14px}
.stats b{display:block;font-size:1.25rem}.stats span{font-size:.85rem;opacity:.75}
.up{color:#6FD08C;font-weight:800}.down{color:#FF8A80;font-weight:800}.flat{opacity:.75}
.grid{display:grid;grid-template-columns:3fr 2fr;gap:16px}
.row{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.btn{background:var(--acc);color:#fff;border:0;border-radius:10px;padding:11px 20px;font:800 1rem Manrope,sans-serif;cursor:pointer}
.btn:disabled{opacity:.6;cursor:wait}
.muted{color:var(--muted)}.err{color:#D1453B;font-weight:700}.ok{color:#3E9A5A;font-weight:700}
.alerts{margin:0;padding-left:20px;color:#D1453B;font-weight:700}
.plan{padding-left:22px}.plan li{margin:8px 0}
form{display:grid;grid-template-columns:1fr 1fr;gap:4px 16px}
label{display:flex;flex-direction:column;gap:4px;font-weight:700;margin:10px 0;font-size:.95rem}
input{padding:11px 12px;border:1px solid var(--line);border-radius:10px;font:inherit;background:var(--paper);color:var(--ink)}
.full{grid-column:1/-1;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
button:focus-visible,input:focus{outline:3px solid #7CCBD2;outline-offset:1px}
svg text{font-family:Manrope,sans-serif}
@media(max-width:760px){.hero,.grid,form{grid-template-columns:1fr}.big{font-size:3rem}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <span class="brand">Credit Assistant</span>
    <nav id="nav"></nav>
  </header>
  <main id="app"></main>
  <p class="muted" style="margin-top:24px;font-size:.85rem">Guidance for education only, not financial advice. Your details stay in this browser.</p>
</div>
<script>
// ---------- calculations (same rules as the FastAPI backend) ----------
const dti=(p,i)=>i>0?+(p/i*100).toFixed(2):0;
const util=(d,l)=>l<=0?(d<=0?0:100):+(d/l*100).toFixed(2);
const cat=s=>s<600?'Poor':s<700?'Fair':s<750?'Good':'Excellent';
const COL={Poor:'#D1453B',Fair:'#E0A100',Good:'#4E9A3A',Excellent:'#14A3B0'};
const inr=n=>new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(n);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const FIELDS=[['score','Credit score (300–900)',300,900],['income','Monthly income (₹)',1],['expenses','Monthly expenses (₹)',0],['emi','Monthly EMIs and card payments (₹)',0],['debt','Total outstanding debt (₹)',0],['limit','Total credit limit (₹)',0]];

// ---------- state (browser storage, always guarded) ----------
const KEY='credit-assistant-v1';
let S={fd:null,hist:[],advice:null};
try{const r=localStorage.getItem(KEY);if(r)S=Object.assign(S,JSON.parse(r))}catch(e){}
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}};
let view='dash',busy=false,msg='',confirmReset=false;

function alertsFor(f){const a=[];
  if(f.util>30)a.push(`Credit utilisation is ${f.util.toFixed(0)}%. Bring it under 30%.`);
  if(f.dti>40)a.push(`Debt-to-income ratio is ${f.dti.toFixed(0)}%. Lenders prefer under 40%.`);
  if(f.expenses>=f.income)a.push('Monthly expenses are at or above income, so missed payments become likely.');
  if(f.score<700)a.push('Your score is below 700, the usual cut-off for the best loan rates.');
  return a}

function commit(v){ // Scenario 1 and 4: recompute, record history and delta
  const prev=S.hist.length?S.hist[S.hist.length-1].s:null;
  S.fd={...v,util:util(v.debt,v.limit),dti:dti(v.emi,v.income)};
  S.hist.push({s:v.score,t:Date.now(),d:prev===null?0:v.score-prev});
  save()}

// ---------- charts (inline SVG) ----------
const pt=(t,r)=>{const a=Math.PI*(1-t);return[150+r*Math.cos(a),150-r*Math.sin(a)]};
const arc=(a,b)=>{const[x0,y0]=pt(a,120),[x1,y1]=pt(b,120);return`M${x0.toFixed(1)} ${y0.toFixed(1)}A120 120 0 0 1 ${x1.toFixed(1)} ${y1.toFixed(1)}`};
function gauge(s){
  const bands=[[0,.5,'Poor'],[.5,2/3,'Fair'],[2/3,.75,'Good'],[.75,1,'Excellent']],t=(s-300)/600,[mx,my]=pt(t,120);
  return`<svg viewBox="0 0 300 190" role="img" aria-label="Score ${s} of 900, ${cat(s)}">
  ${bands.map(([a,b,n])=>`<path d="${arc(a,b)}" stroke="${COL[n]}" stroke-width="16" fill="none" opacity="${cat(s)===n?1:.4}"/>`).join('')}
  <circle cx="${mx.toFixed(1)}" cy="${my.toFixed(1)}" r="11" fill="#fff" stroke="#10213C" stroke-width="4"/>
  <text x="150" y="132" text-anchor="middle" font-size="46" font-weight="800" fill="#fff">${s}</text>
  <text x="150" y="156" text-anchor="middle" font-size="13" fill="#9FB3D1">out of 900</text>
  <text x="26" y="178" font-size="11" fill="#9FB3D1">300</text><text x="274" y="178" text-anchor="end" font-size="11" fill="#9FB3D1">900</text></svg>`}

function line(h){
  const W=520,H=230,L=40,R=12,T=14,B=30,v=h.map(x=>x.s);
  let lo=Math.max(300,Math.min(...v)-30),hi=Math.min(900,Math.max(...v)+30);if(hi-lo<60)hi=lo+60;
  const X=i=>L+(h.length<2?(W-L-R)/2:i*(W-L-R)/(h.length-1)),Y=s=>T+(hi-s)/(hi-lo)*(H-T-B);
  const grid=[0,1,2,3].map(k=>{const s=lo+(hi-lo)*k/3;return`<line x1="${L}" x2="${W-R}" y1="${Y(s)}" y2="${Y(s)}" stroke="var(--line)"/><text x="${L-6}" y="${Y(s)+4}" text-anchor="end" font-size="11" fill="var(--muted)">${Math.round(s)}</text>`}).join('');
  const step=Math.ceil(h.length/6);
  const labels=h.map((x,i)=>i%step===0||i===h.length-1?`<text x="${X(i)}" y="${H-8}" text-anchor="middle" font-size="11" fill="var(--muted)">${new Date(x.t).toLocaleDateString('en-IN',{day:'numeric',month:'short'})}</text>`:'').join('');
  const pts=h.map((x,i)=>`${X(i)},${Y(x.s)}`).join(' ');
  const dots=h.map((x,i)=>`<circle cx="${X(i)}" cy="${Y(x.s)}" r="4.5" fill="var(--acc)"><title>${x.s} on ${new Date(x.t).toLocaleDateString('en-IN')}</title></circle>`).join('');
  return`<svg viewBox="0 0 ${W} ${H}" width="100%" role="img" aria-label="Credit score over time">${grid}${labels}<polyline points="${pts}" fill="none" stroke="var(--acc)" stroke-width="3" stroke-linejoin="round"/>${dots}</svg>`}

function donut(f){
  const p=Math.min(f.util,100),C=2*Math.PI*60,c=f.util>30?'#D1453B':'var(--acc)';
  return`<svg viewBox="0 0 160 160" width="100%" style="max-width:220px;display:block;margin:0 auto" role="img" aria-label="Utilisation ${f.util}%">
  <circle cx="80" cy="80" r="60" fill="none" stroke="var(--track)" stroke-width="18"/>
  <circle cx="80" cy="80" r="60" fill="none" stroke="${c}" stroke-width="18" stroke-dasharray="${C*p/100} ${C}" transform="rotate(-90 80 80)"/>
  <text x="80" y="88" text-anchor="middle" font-size="26" font-weight="800" fill="var(--ink)">${f.util.toFixed(0)}%</text></svg>`}

// ---------- AI advice: Claude via the page's sample capability, rules as fallback ----------
function fallback(f){return{source:'rules',analysis:`Your score of ${f.score} is rated ${cat(f.score)}. Utilisation is ${f.util.toFixed(0)}% and EMIs take ${f.dti.toFixed(0)}% of income. Lower utilisation and on-time payments are the fastest levers.`,
  plan:[f.util>30?`Cut utilisation from ${f.util.toFixed(0)}% to under 30%: pay balances down before the statement date.`:'Keep utilisation under 30% of your limit; request a limit increase instead of spending more.',
  'Pay every EMI and card bill by the due date. Turn on UPI Autopay or bank auto-debit so nothing slips.',
  f.dti>40?`EMIs take ${f.dti.toFixed(0)}% of income. Prepay the costliest loan or consolidate to get under 40%.`:'Your EMI burden is healthy. Avoid new loans until your score improves.',
  f.score<700?'Take a secured card against a fixed deposit and repay it in full every month to build history.':'Keep your oldest cards open: a long credit history supports 750+.',
  'Download your free annual CIBIL report, dispute errors, and avoid applying to several lenders within a few months.']}}

async function getAdvice(){
  const f=S.fd;
  try{
    const sample=window.claude?await window.claude.use('sample'):null;
    if(!sample)return fallback(f);
    const r=await sample.json(`You are a credit advisor for India (CIBIL 300-900, RBI norms). Metrics in INR: score ${f.score}, income ${f.income}/month, expenses ${f.expenses}/month, EMIs ${f.emi}/month, total debt ${f.debt}, credit limit ${f.limit}, utilisation ${f.util}%, debt-to-income ${f.dti}%. Reply with ONLY JSON {"analysis":"3-4 sentences","plan":["exactly 5 short, specific steps"]}. Make steps specific to Indian banking: CIBIL disputes, EMI and UPI Autopay habits, secured cards against FDs, utilisation under 30%, limiting loan enquiries. No guarantees.`);
    if(!r||!Array.isArray(r.plan)||r.plan.length!==5||!r.analysis)throw new Error('bad shape');
    return{source:'claude',analysis:String(r.analysis),plan:r.plan.map(String)}
  }catch(e){return fallback(f)}}

// ---------- views ----------
function adviceCard(title){const a=S.advice;
  return`<section class="card"><div class="row"><h2>${title}</h2><button class="btn" data-a="advice" ${busy?'disabled':''}>${busy?'Analysing your finances…':a?'Refresh AI advice':'Get AI advice'}</button></div>
  ${!a&&!busy?'<p class="muted">Get a personalised 5-step plan based on your latest numbers.</p>':''}
  ${a?`<p>${esc(a.analysis)}</p><ol class="plan">${a.plan.map(s=>`<li>${esc(s)}</li>`).join('')}</ol>${a.source==='rules'?'<small class="muted">AI was unavailable, so this plan comes from built-in rules.</small>':''}`:''}</section>`}

function dash(){
  const f=S.fd;
  if(!f)return`<section class="card"><h2>Add your financial details</h2><p class="muted">Enter your score, income and debts to see your dashboard, or explore with sample numbers.</p><div class="row" style="justify-content:flex-start"><button class="btn" data-a="go" data-v="data">Enter details</button><button class="ghost" data-a="demo">Load demo data</button></div></section>`;
  const last=S.hist[S.hist.length-1],d=last?last.d:0,c=cat(f.score),al=alertsFor(f);
  return`<section class="card hero"><div>${gauge(f.score)}</div><div>
    <div><span class="big">${f.score}</span><span class="badge" style="background:${COL[c]}">${c}</span></div>
    <div class="${d>0?'up':d<0?'down':'flat'}" style="margin-top:6px">${d>0?'▲ ':d<0?'▼ ':''}${d===0?'No change':Math.abs(d)+' points'} since last update</div>
    <div class="stats"><div><b>${f.util.toFixed(1)}%</b><span>Credit utilisation</span></div><div><b>${f.dti.toFixed(1)}%</b><span>Debt-to-income</span></div></div></div></section>
  <section class="card"><h2>What is holding your score back</h2>${al.length?`<ul class="alerts">${al.map(a=>`<li>${esc(a)}</li>`).join('')}</ul>`:'<p class="ok">No bottlenecks flagged. Keep paying on time.</p>'}</section>
  <div class="grid"><section class="card"><h2>Score over time</h2>${line(S.hist)}</section>
  <section class="card"><h2>Credit utilisation</h2>${donut(f)}<p class="muted" style="text-align:center;margin:8px 0 0">${inr(f.debt)} used of ${inr(f.limit)}</p></section></div>
  ${adviceCard('Your roadmap to Excellent')}`}

function data(){const f=S.fd||{};
  return`<section class="card"><h2>${S.fd?'Update your details':'Your financial details'}</h2><p class="muted">We calculate your debt-to-income ratio and credit utilisation from these.</p>
  <form id="f" novalidate>${FIELDS.map(([k,l,mn,mx])=>`<label>${l}<input name="${k}" type="number" inputmode="decimal" step="any" min="${mn}" ${mx?`max="${mx}"`:''} value="${f[k]??''}" required></label>`).join('')}
  <div class="full"><button class="btn">${S.fd?'Save and update dashboard':'Save details'}</button>${msg?`<span class="err" role="alert">${esc(msg)}</span>`:''}</div></form></section>`}

function render(){
  const tabs=[['dash','Dashboard'],['data','Update details'],['adv','AI advisor']];
  document.getElementById('nav').innerHTML=tabs.map(([k,l])=>`<button class="${view===k?'on':''}" data-a="go" data-v="${k}">${l}</button>`).join('')+(S.fd?`<button class="ghost" data-a="reset">${confirmReset?'Click again to erase':'Reset data'}</button>`:'');
  document.getElementById('app').innerHTML=view==='data'?data():view==='adv'?(S.fd?`<h2 style="font-size:1.7rem">AI advisor</h2>${adviceCard('Analysis and 5-step plan')}`:dash()):dash();
  window.scrollTo(0,0)}

// ---------- events ----------
document.addEventListener('click',async e=>{
  const b=e.target.closest('[data-a]');if(!b)return;const a=b.dataset.a;
  if(a!=='reset')confirmReset=false;
  if(a==='go'){view=b.dataset.v;msg='';render()}
  else if(a==='demo'){S={fd:null,hist:[],advice:null};
    [596,612,625,641,658,672].forEach((s,i)=>S.hist.push({s,t:Date.now()-(6-i)*30*864e5,d:i?s-[596,612,625,641,658,672][i-1]:0}));
    commit({score:688,income:85000,expenses:52000,emi:28000,debt:240000,limit:300000});view='dash';render()}
  else if(a==='reset'){if(!confirmReset){confirmReset=true;render();return}
    S={fd:null,hist:[],advice:null};save();confirmReset=false;view='dash';render()}
  else if(a==='advice'){busy=true;render();S.advice=await getAdvice();busy=false;save();render()}
});
document.addEventListener('submit',e=>{
  if(e.target.id!=='f')return;e.preventDefault();
  const v={};for(const[k,l,mn,mx]of FIELDS){const n=Number(e.target.elements[k].value);
    if(e.target.elements[k].value===''||!isFinite(n)||n<mn||(mx&&n>mx)){msg=`${l.split(' (')[0]} must be ${mx?`between ${mn} and ${mx}`:`${mn} or more`}.`;render();return}
    v[k]=n}
  msg='';commit(v);S.advice=S.advice; view='dash';render()});
render();
</script>
</body>
</html>
